<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        account_payment hides the "Pay" buttons while the invoice has an
        authorized (not yet captured/voided) transaction. Apply the same
        rule to their "Collect" twins.
    -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.account_translation_improvements_account_payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_collect_btn']" position="attributes">
                <attribute name="invisible" separator="or" add="authorized_transaction_ids"/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_collect_secondary_btn']" position="attributes">
                <attribute name="invisible" separator="or" add="authorized_transaction_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
