<?xml version="1.0" encoding="utf-8"?>
<templates>
    <t t-name="account_statement_reconcile_improvements.BankRecoKanbanController"
       t-inherit="account_accountant.BankRecoKanbanController" t-inherit-mode="primary">
        <xpath expr="//button[hasclass('bank-chatter-btn')]" position="after">
            <button t-on-click="actionAutoReconcileUnassigned"
                    class="btn btn-secondary d-none d-md-inline"
                    title="For unreconciled lines with no partner, look for a unique open invoice/payment matching on date and amount, and reconcile it">
                Auto-reconcile unassigned
            </button>
        </xpath>
    </t>
</templates>
