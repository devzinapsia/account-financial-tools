<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Right below core's "Internal Transfer" account, inside the
         "Bank transactions and payments" setting of "Default Accounts". -->
    <record id="res_config_settings_view_form_intercompany_transfer" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.intercompany.transfer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='post_bank_transactions_and_payments_setting']/div[hasclass('content-group')]" position="inside">
                <div class="row mt8">
                    <label for="intercompany_transfer_account_id" class="col-lg-5 o_light_label"/>
                    <field name="intercompany_transfer_account_id"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
