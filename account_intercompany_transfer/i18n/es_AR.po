#: code:addons/account_intercompany_transfer/models/res_company.py:0
msgid ""
"The intercompany transfer bridge account %(account)s does not belong to "
"%(company)s."
msgstr ""
"La cuenta transitoria intercompañía %(account)s no pertenece a "
"%(company)s."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/res_company.py:0
msgid "The intercompany transfer bridge account %(account)s is archived."
msgstr ""
"La cuenta transitoria intercompañía %(account)s está archivada."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/res_company.py:0
msgid ""
"The intercompany transfer bridge account %(account)s is the outstanding "
"account of the payment method %(method)s of the journal %(journal)s. Use a "
"dedicated account."
msgstr ""
"La cuenta transitoria intercompañía %(account)s es la cuenta de "
"pagos pendientes del método de pago %(method)s del diario %(journal)s. Use "
"una cuenta exclusiva."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/res_company.py:0
msgid ""
"The intercompany transfer bridge account %(account)s must be a current asset"
" or a current liability account."
msgstr ""
"La cuenta transitoria intercompañía %(account)s debe ser una "
"cuenta de activo corriente o de pasivo corriente."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid "The journal %(journal)s does not belong to %(company)s."
msgstr "El diario %(journal)s no pertenece a %(company)s."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"The journal %(journal)s has no manual payment method to %(direction)s money."
msgstr ""
"El diario %(journal)s no tiene un método de pago manual para %(direction)s "
"dinero."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid "The journal %(journal)s must be a bank or cash journal."
msgstr "El diario %(journal)s debe ser un diario de banco o de efectivo."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid "The origin and destination companies must be different."
msgstr "Las empresas origen y destino deben ser distintas."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"The origin journal %(origin)s is in %(origin_currency)s and the destination "
"journal %(destination)s is in %(destination_currency)s. Intercompany "
"transfers require both journals in the same currency."
msgstr ""
"El diario origen %(origin)s está en %(origin_currency)s y el diario destino "
"%(destination)s está en %(destination_currency)s. Las transferencias "
"intercompany requieren los dos diarios en la misma moneda."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_payment.py:0
msgid ""
"The payment %(payment)s belongs to the intercompany transfer %(transfer)s. "
"Cancel the transfer instead of changing its payments."
msgstr ""
"El pago %(payment)s pertenece a la transferencia intercompany %(transfer)s. "
"Cancele la transferencia en lugar de modificar sus pagos."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_payment.py:0
msgid ""
"The payment %(payment)s is an internal transfer (%(markers)s) and can't be "
"part of the intercompany transfer %(transfer)s."
msgstr ""
"El pago %(payment)s es una transferencia interna (%(markers)s) y no puede "
"formar parte de la transferencia intercompany %(transfer)s."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_payment.py:0
msgid ""
"The payment %(payment)s was not created by the intercompany transfer "
"%(transfer)s."
msgstr ""
"El pago %(payment)s no fue creado por la transferencia intercompany "
"%(transfer)s."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"The payment method %(method)s of the journal %(journal)s has no outstanding "
"account. Set it on the journal, in the incoming/outgoing payments tab."
msgstr ""
"El método de pago %(method)s del diario %(journal)s no tiene cuenta de pagos"
" pendientes. Configúrela en el diario, en la pestaña de pagos "
"entrantes/salientes."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"The transfer %(transfer)s can't be cancelled: the payment %(payment)s of "
"%(company)s %(reason)s. Undo that reconciliation first."
msgstr ""
"La transferencia %(transfer)s no se puede cancelar: el pago %(payment)s de "
"%(company)s %(reason)s. Deshaga primero esa conciliación."

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"The transfer %(transfer)s can't be cancelled: the payment %(payment)s of "
"%(company)s is dated in a closed period. %(error)s"
msgstr ""
"La transferencia %(transfer)s no se puede cancelar: el pago %(payment)s de "
"%(company)s tiene fecha en un período cerrado. %(error)s"

#. module: account_intercompany_transfer
#. odoo-python
#: code:addons/account_intercompany_transfer/models/account_intercompany_transfer.py:0
msgid ""
"This payment of %(transfer)s belongs to %(company)s. Select that company in "
"the company switcher to open it."
msgstr ""
"Este pago de %(transfer)s pertenece a %(company)s. Seleccione esa empresa en"
" el selector de empresas para abrirlo."

#. module: account_intercompany_transfer
#: model_terms:ir.ui.view,arch_db:account_intercompany_transfer.account_intercompany_transfer_view_list
msgid "Total"
msgstr "Total"

