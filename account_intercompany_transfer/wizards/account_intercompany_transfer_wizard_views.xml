<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_intercompany_transfer_wizard_view_form" model="ir.ui.view">
        <field name="name">account.intercompany.transfer.wizard.form</field>
        <field name="model">account.intercompany.transfer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="picker_company_ids" invisible="1"/>
                <field name="origin_journal_domain" invisible="1"/>
                <field name="destination_company_domain" invisible="1"/>
                <field name="destination_journal_domain" invisible="1"/>
                <group>
                    <group name="origin">
                        <!-- allowed_company_ids: let the pickers find records
                             of companies not ticked in the switcher. -->
                        <field name="origin_journal_id"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'allowed_company_ids': picker_company_ids}"/>
                        <field name="company_id" options="{'no_open': True}"/>
                        <field name="currency_id" options="{'no_open': True}"/>
                        <field name="date"/>
                    </group>
                    <group name="destination">
                        <field name="destination_company_id"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'allowed_company_ids': picker_company_ids}"/>
                        <field name="destination_journal_id"
                               options="{'no_create': True, 'no_open': True}"
                               context="{'allowed_company_ids': picker_company_ids}"
                               readonly="not destination_company_id or not origin_journal_id"/>
                        <field name="amount"/>
                        <field name="memo"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_intercompany_transfer_wizard" model="ir.actions.act_window">
        <field name="name">New intercompany transfer</field>
        <field name="res_model">account.intercompany.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('group_intercompany_transfer_user'))]"/>
    </record>

</odoo>
