<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account_payment_review.ReviewBadgeCharField" t-inherit="web.CharField" t-inherit-mode="primary">
        <xpath expr="//span" position="after">
            <span t-if="reviewBadgeClass"
                  t-attf-class="badge rounded-pill mx-2 d-inline-flex {{ reviewBadgeClass }}"
                  t-esc="reviewBadgeLabel"/>
        </xpath>
    </t>

</templates>
