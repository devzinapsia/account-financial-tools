<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Internal and not followed by default: review comments are an
             internal control, never e-mailed to the payment's followers
             (which may include the vendor). -->
        <record id="mt_payment_review" model="mail.message.subtype">
            <field name="name">Payment review</field>
            <field name="res_model">account.payment</field>
            <field name="default" eval="False"/>
            <field name="internal" eval="True"/>
            <field name="description">Payment review</field>
        </record>

    </data>
</odoo>
