#. module: l10n_ar_invoice_service_dates_required
#: model:ir.model.fields,help:l10n_ar_invoice_service_dates_required.field_account_journal__l10n_ar_service_period_default
msgid ""
"Service billing period proposed on electronic invoices of this journal with an ARCA concept of Services or Products and Services:\n"
"- Empty: nothing is proposed, the user enters the dates.\n"
"- Invoice month: first to last day of the invoice date's month.\n"
"- Invoice day: the invoice date itself, as both start and end.\n"
"If the dates are still empty when the invoice is confirmed, they are filled in with the invoice day when that option is selected, or with the invoice month otherwise, since ARCA requires them."
msgstr ""

