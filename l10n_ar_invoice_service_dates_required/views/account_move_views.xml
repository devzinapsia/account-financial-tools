<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ar.service.dates.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_ar.view_move_form"/>
        <field name="arch" type="xml">
            <field name="l10n_ar_afip_concept" position="after">
                <field name="l10n_ar_service_period_dates_required" invisible="1"/>
            </field>
            <field name="l10n_ar_afip_service_start" position="attributes">
                <attribute name="required">l10n_ar_service_period_dates_required</attribute>
            </field>
            <field name="l10n_ar_afip_service_end" position="attributes">
                <attribute name="required">l10n_ar_service_period_dates_required</attribute>
            </field>
        </field>
    </record>

</odoo>
