<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.l10n.ar.service.dates.required</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_ar.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Technical flags read and set by the service period onchanges:
                 they must be in the form so their value is kept between
                 onchange calls before the invoice is saved -->
            <field name="l10n_ar_afip_service_end" position="after">
                <field name="l10n_ar_service_period_no_default" invisible="1"/>
                <field name="l10n_ar_service_period_proposed" invisible="1"/>
            </field>
        </field>
    </record>

</odoo>
