<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form.l10n.ar.service.dates.required</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_ar.view_account_journal_form"/>
        <field name="arch" type="xml">
            <!-- Right column of the journal header, so the ARCA options don't
                 push the left column down -->
            <field name="country_code" position="after">
                <field name="l10n_ar_service_period_dates_required"
                       invisible="not l10n_ar_is_pos or type != 'sale'"/>
                <field name="l10n_ar_service_period_default"
                       invisible="not l10n_ar_is_pos or type != 'sale'"/>
                <field name="l10n_ar_service_period_print"
                       invisible="not l10n_ar_is_pos or type != 'sale'"/>
            </field>
        </field>
    </record>

</odoo>
