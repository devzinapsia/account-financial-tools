<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Hide the invoiced period when the journal is set not to print it -->
    <template id="report_invoice_document" inherit_id="l10n_ar.report_invoice_document">
        <xpath expr="//t[contains(@t-if, 'o.l10n_ar_afip_service_start and o.l10n_ar_afip_service_end')]" position="attributes">
            <attribute name="t-if">o.l10n_ar_afip_concept in ['2', '3', '4'] and o.l10n_ar_afip_service_start and o.l10n_ar_afip_service_end and o._l10n_ar_print_service_period()</attribute>
        </xpath>
    </template>

</odoo>
