<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_vendor_bill_authorization_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">account.vendor.bill.authorization.reject.wizard.form</field>
        <field name="model">account.vendor.bill.authorization.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject vendor bill">
                <group>
                    <field name="move_id" readonly="1" invisible="1"/>
                    <field name="reason" placeholder="Explain why this vendor bill is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
