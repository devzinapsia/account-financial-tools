<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: header buttons (next to "Confirm") + new "Authorization"
         page, only for vendor bills and vendor credit/debit notes. High
         priority so the page is appended after any other module's pages,
         right after "Other Info", regardless of module load order. -->
    <record id="view_move_form_authorization" model="ir.ui.view">
        <field name="name">account.move.form.authorization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <!-- Authorize only: does not confirm the vendor bill. Available
                 on any draft bill the current user is a pending authorizer
                 for, even before anyone attempts (and is blocked from)
                 confirming it. Once authorized, the regular "Confirm"
                 button lets anyone finish confirming it, not just an
                 authorized user; see account_move.py action_post(). -->
            <xpath expr="//header/button[@name='action_post'][last()]" position="after">
                <button name="action_authorize_bill" string="Authorize" type="object"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or is_blocked or authorization_state in ('authorized', 'rejected') or uid not in pending_authorizer_ids"
                        groups="account.group_account_invoice"/>
                <button name="action_authorize_and_confirm_bill" string="Authorize + Confirm" type="object"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or is_blocked or authorization_state in ('authorized', 'rejected') or uid not in pending_authorizer_ids"
                        groups="account.group_account_invoice"/>
                <!-- Undoes a mistaken Authorize click: only shown once the
                     bill is authorized but not yet confirmed. See
                     account_move.py action_unauthorize_bill(). -->
                <button name="action_unauthorize_bill" string="Unauthorize" type="object"
                        invisible="state != 'draft' or move_type not in ('in_invoice', 'in_refund') or authorization_state != 'authorized' or uid not in pending_authorizer_ids"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="after">
                <page name="authorization" string="Authorization"
                      invisible="move_type not in ('in_invoice', 'in_refund')">
                    <group>
                        <field name="authorization_state" widget="badge"
                               decoration-info="authorization_state == 'to_authorize'"
                               decoration-success="authorization_state == 'authorized'"
                               decoration-danger="authorization_state == 'rejected'"
                               decoration-muted="authorization_state == 'not_required'"/>
                        <field name="is_blocked" readonly="1" invisible="not is_blocked"/>
                    </group>
                    <group>
                        <group>
                            <field name="matched_policy_ids" widget="many2many_tags" readonly="1"/>
                            <field name="pending_authorizer_ids" widget="many2many_avatar_user" readonly="1"/>
                        </group>
                        <group>
                            <field name="authorized_by_id" readonly="1"/>
                            <field name="authorization_reject_reason" readonly="1"
                                   invisible="authorization_state != 'rejected'"/>
                        </group>
                    </group>
                    <button name="action_reject_bill" string="Reject" type="object"
                            class="btn btn-secondary"
                            invisible="state != 'draft' or is_blocked or authorization_state in ('authorized', 'rejected') or uid not in pending_authorizer_ids"
                            groups="account.group_account_invoice"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vendor bills and vendor credit/debit notes lists: optional
         authorization status column. account.view_in_invoice_tree is the
         common parent of both account.view_in_invoice_bill_tree (Bills
         action) and account.view_in_invoice_refund_tree (Refunds action),
         so extending it covers both. -->
    <record id="view_in_invoice_tree_authorization" model="ir.ui.view">
        <field name="name">account.in.invoice.list.authorization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="before">
                <field name="authorization_state" widget="badge"
                       decoration-info="authorization_state == 'to_authorize'"
                       decoration-success="authorization_state == 'authorized'"
                       decoration-danger="authorization_state == 'rejected'"
                       decoration-muted="authorization_state == 'not_required'"
                       optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Bills search (used by both the Bills and Refunds actions):
         authorization filters -->
    <record id="view_account_bill_filter_authorization" model="ir.ui.view">
        <field name="name">account.move.bill.search.authorization</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <filter name="cancel" position="after">
                <separator/>
                <!-- Both filters target vendor bills that are actually
                     actionable right now: a draft that still has a pending
                     authorizer, isn't permanently blocked, and hasn't
                     already been authorized or rejected. This matches
                     exactly what makes the "Authorize" / "Reject" buttons
                     visible on the form. -->
                <filter string="To authorize" name="authorization_to_authorize"
                        domain="[('state', '=', 'draft'),
                                 ('pending_authorizer_ids', '!=', False),
                                 ('is_blocked', '=', False),
                                 ('authorization_state', 'not in', ['authorized', 'rejected'])]"/>
                <filter string="To authorize by me" name="authorization_to_authorize_by_me"
                        domain="[('state', '=', 'draft'),
                                 ('pending_authorizer_ids', 'in', [uid]),
                                 ('is_blocked', '=', False),
                                 ('authorization_state', 'not in', ['authorized', 'rejected'])]"/>
                <!-- Vendor bills I loaded myself that needed authorization,
                     already got it, but that still haven't been confirmed:
                     easy to lose track of among many drafts otherwise. -->
                <filter string="Authorized, not confirmed by me yet" name="authorization_authorized_unconfirmed_by_me"
                        domain="[('state', '=', 'draft'),
                                 ('authorization_state', '=', 'authorized'),
                                 ('create_uid', '=', uid)]"/>
            </filter>
        </field>
    </record>

</odoo>
