<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        account_payment_financial_surcharge replaces the whole invisible
        condition of both "Pay" buttons (so they also show on draft invoices,
        only hidden once cancelled) and points them to
        action_force_register_payment with open_invoice_payment in context.

        - "Collect" buttons: same changes, restricted to customer documents.
        - "Pay" buttons: their condition is set again, restricted to vendor
          documents, since the surcharge view drops the customer exclusion
          added by account_translation_improvements when it's applied after
          it.

        The high priority makes this view apply after both of them, whatever
        the order they were installed in. Like the surcharge view, it
        replaces the conditions other modules add (e.g. account_payment's
        authorized transactions), so "Pay" and "Collect" behave the same.
    -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.account_translation_improvements_account_payment_financial_surcharge</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <button id="account_invoice_payment_btn" position="attributes">
                <attribute name="invisible">(
                    state == 'cancel'
                    or payment_state not in ('not_paid', 'partial', 'in_payment')
                    or move_type not in ('in_invoice', 'in_refund', 'in_receipt')
                    or invoice_has_outstanding
                )</attribute>
            </button>
            <button id="account_invoice_payment_secondary_btn" position="attributes">
                <attribute name="invisible">(
                    state == 'cancel'
                    or payment_state not in ('not_paid', 'partial', 'in_payment')
                    or move_type not in ('in_invoice', 'in_refund', 'in_receipt')
                    or not invoice_has_outstanding
                )</attribute>
            </button>
            <button id="account_invoice_collect_btn" position="attributes">
                <attribute name="invisible">(
                    state == 'cancel'
                    or payment_state not in ('not_paid', 'partial', 'in_payment')
                    or move_type not in ('out_invoice', 'out_refund', 'out_receipt')
                    or invoice_has_outstanding
                )</attribute>
                <attribute name="context">{'open_invoice_payment': True}</attribute>
                <attribute name="name">action_force_register_payment</attribute>
            </button>
            <button id="account_invoice_collect_secondary_btn" position="attributes">
                <attribute name="invisible">(
                    state == 'cancel'
                    or payment_state not in ('not_paid', 'partial', 'in_payment')
                    or move_type not in ('out_invoice', 'out_refund', 'out_receipt')
                    or not invoice_has_outstanding
                )</attribute>
                <attribute name="context">{'open_invoice_payment': True}</attribute>
                <attribute name="name">action_force_register_payment</attribute>
            </button>
        </field>
    </record>

</odoo>
