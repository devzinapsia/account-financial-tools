<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="email_compose_message_wizard_form" model="ir.ui.view">
        <field name="name">mail.compose.message.form.payment.email.invoices</field>
        <field name="model">mail.compose.message</field>
        <field name="inherit_id" ref="mail.email_compose_message_wizard_form"/>
        <field name="arch" type="xml">
            <!-- Below the attachments of the monorecord composer (the only one
                 with a preview of the attachments). -->
            <xpath expr="//form/div/field[@name='attachment_ids']" position="after">
                <div class="alert alert-warning mt-2 mb-0" role="alert" invisible="not payment_attachment_size_warning">
                    <field name="payment_attachment_size_warning" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
