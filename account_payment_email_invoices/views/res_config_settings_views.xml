<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payment.email.invoices</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='print_vendor_checks_setting_container']" position="after">
                <block title="Payment emails" id="payment_email_invoices_setting_container">
                    <setting id="attach_invoices_on_payment_order_setting"
                        company_dependent="1"
                        help="When a payment order is sent by email, also attach the PDF of the vendor bills and credit notes it settles (the PDF attached to each bill).">
                        <field name="attach_invoices_on_payment_order"/>
                    </setting>
                    <setting id="attach_invoices_on_receipt_setting"
                        company_dependent="1"
                        help="When a receipt is sent by email, also attach the PDF of the customer invoices and credit notes it settles (the same PDF the customer receives).">
                        <field name="attach_invoices_on_receipt"/>
                    </setting>
                    <setting id="no_attachment_journal_setting"
                        company_dependent="1"
                        string="Journals whose invoices are not attached"
                        help="Example: document adjustment journals loaded by the Go Live."
                        invisible="not attach_invoices_on_payment_order and not attach_invoices_on_receipt">
                        <field name="no_attachment_journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
