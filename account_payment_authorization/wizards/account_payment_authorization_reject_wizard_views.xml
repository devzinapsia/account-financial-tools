<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_payment_authorization_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">account.payment.authorization.reject.wizard.form</field>
        <field name="model">account.payment.authorization.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject payment">
                <group>
                    <field name="payment_id" readonly="1" invisible="1"/>
                    <field name="reason" placeholder="Explain why this payment is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
