<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form view: header "Authorize" button (next to "Confirm") + new
         "Authorization" page. High priority so the page is appended after
         any other module's pages inside the same notebook (e.g.
         ingadhoc's "Debts" / "Withholdings" tabs), keeping "Authorization"
         last regardless of module load order. -->
    <record id="view_account_payment_form_authorization" model="ir.ui.view">
        <field name="name">account.payment.form.authorization</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority" eval="999"/>
        <field name="arch" type="xml">
            <!-- Authorize only: does not confirm the payment. Available on
                 any draft payment the current user is a pending
                 authorizer for, even before anyone attempts (and is
                 blocked from) confirming it, since the person confirming
                 often cannot be authorized themselves, so they can never
                 be the one to trigger the blocked "to_authorize" state.
                 Once authorized, the regular "Confirm" button (above)
                 lets anyone finish confirming it, not just an authorized
                 user; see account_payment.py action_post(). -->
            <button name="action_post" position="after">
                <button name="action_authorize_payment" string="Authorize" type="object"
                        invisible="state != 'draft' or authorization_state in ('authorized', 'rejected') or uid not in pending_authorizer_ids"
                        data-hotkey="z"/>
            </button>
            <xpath expr="//notebook[@name='payment_notebook']" position="inside">
                <page name="authorization" string="Authorization"
                      invisible="partner_type != 'supplier'">
                    <group>
                        <field name="authorization_state" widget="badge"
                               decoration-info="authorization_state == 'to_authorize'"
                               decoration-success="authorization_state == 'authorized'"
                               decoration-danger="authorization_state == 'rejected'"
                               decoration-muted="authorization_state == 'not_required'"/>
                    </group>
                    <group>
                        <group>
                            <field name="matched_scheme_ids" widget="many2many_tags" readonly="1"/>
                            <field name="pending_authorizer_ids" widget="many2many_avatar_user" readonly="1"/>
                        </group>
                        <group>
                            <field name="authorized_by_id" readonly="1"/>
                            <field name="authorization_reject_reason" readonly="1"
                                   invisible="authorization_state != 'rejected'"/>
                        </group>
                    </group>
                    <button name="action_reject_payment" string="Reject" type="object"
                            class="btn btn-secondary"
                            invisible="state != 'draft' or authorization_state in ('authorized', 'rejected') or uid not in pending_authorizer_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Vendor Payments list: optional authorization status column -->
    <record id="view_account_supplier_payment_tree_authorization" model="ir.ui.view">
        <field name="name">account.supplier.payment.list.authorization</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="authorization_state" widget="badge"
                       decoration-info="authorization_state == 'to_authorize'"
                       decoration-success="authorization_state == 'authorized'"
                       decoration-danger="authorization_state == 'rejected'"
                       decoration-muted="authorization_state == 'not_required'"
                       optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Payments search: "To authorize" / "To authorize by me" filters -->
    <record id="view_account_payment_search_authorization" model="ir.ui.view">
        <field name="name">account.payment.search.authorization</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <filter name="state_in_process" position="after">
                <!-- Both filters target payments that are actually
                     actionable right now: a draft that still has a
                     pending authorizer, and hasn't already been
                     authorized or rejected. This matches exactly what
                     makes the "Authorize" / "Reject" buttons visible on
                     the form (see account_payment_views.xml), including
                     drafts nobody has attempted to confirm yet, not only
                     ones already blocked into "to_authorize". -->
                <filter string="To authorize" name="authorization_to_authorize"
                        domain="[('state', '=', 'draft'),
                                 ('pending_authorizer_ids', '!=', False),
                                 ('authorization_state', 'not in', ['authorized', 'rejected'])]"/>
                <filter string="To authorize by me" name="authorization_to_authorize_by_me"
                        domain="[('state', '=', 'draft'),
                                 ('pending_authorizer_ids', 'in', [uid]),
                                 ('authorization_state', 'not in', ['authorized', 'rejected'])]"/>
            </filter>
        </field>
    </record>

</odoo>
