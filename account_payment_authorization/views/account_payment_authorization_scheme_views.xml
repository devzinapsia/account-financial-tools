<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view: no inline editing, clicking a row opens the form -->
    <record id="account_payment_authorization_scheme_view_list" model="ir.ui.view">
        <field name="name">account.payment.authorization.scheme.list</field>
        <field name="model">account.payment.authorization.scheme</field>
        <field name="arch" type="xml">
            <list string="Payment authorization schemes">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="domain" optional="hide"/>
                <field name="block_payment"/>
                <field name="authorized_user_ids" widget="many2many_tags"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="account_payment_authorization_scheme_view_form" model="ir.ui.view">
        <field name="name">account.payment.authorization.scheme.form</field>
        <field name="model">account.payment.authorization.scheme</field>
        <field name="arch" type="xml">
            <form string="Payment authorization scheme">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Conditions">
                        <field name="domain" nolabel="1" colspan="2"
                               widget="domain" options="{'model': 'account.payment'}"/>
                    </group>
                    <group>
                        <group>
                            <field name="block_payment"/>
                        </group>
                        <group string="Authorized users" invisible="block_payment">
                            <field name="authorized_user_ids" nolabel="1" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="account_payment_authorization_scheme_view_search" model="ir.ui.view">
        <field name="name">account.payment.authorization.scheme.search</field>
        <field name="model">account.payment.authorization.scheme</field>
        <field name="arch" type="xml">
            <search string="Search payment authorization schemes">
                <field name="name"/>
                <field name="authorized_user_ids"/>
                <filter string="Always block" name="block_payment" domain="[('block_payment', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Company" name="by_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_account_payment_authorization_scheme" model="ir.actions.act_window">
        <field name="name">Payment Authorization Schemes</field>
        <field name="res_model">account.payment.authorization.scheme</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account_payment_authorization_scheme_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first payment authorization scheme
            </p>
            <p>
                Authorization schemes define, through a domain condition on
                the payment (including its linked vendor bill), which users
                must authorize a vendor payment before it can be confirmed,
                or whether it must always be blocked.
            </p>
        </field>
    </record>

    <!-- Menu item under Configuration > Invoicing, next to Invoice Classifications -->
    <menuitem
        id="menu_account_payment_authorization_scheme"
        name="Payment Authorization Schemes"
        parent="account.account_invoicing_menu"
        action="action_account_payment_authorization_scheme"
        sequence="55"
        groups="account.group_account_manager"/>

</odoo>
