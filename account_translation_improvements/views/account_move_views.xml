<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        account.view_move_form is shared by every move_type. Each of the two
        "Pay" buttons is hidden for customer documents and gets a "Collect"
        twin (same action/context/groups/hotkey) that is only visible for
        them, so exactly one of the pair shows on any given invoice.
    -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.account_translation_improvements</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible" add="move_type in ('out_invoice', 'out_refund', 'out_receipt')" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="after">
                <button name="action_register_payment" id="account_invoice_collect_btn"
                        type="object" class="oe_highlight"
                        invisible="(
                            state != 'posted'
                            or payment_state not in ('not_paid', 'partial', 'in_payment')
                            or move_type not in ('out_invoice', 'out_refund', 'out_receipt')
                            or invoice_has_outstanding
                        )"
                        context="{'dont_redirect_to_payments': True, 'display_account_trust': True}"
                        string="Collect" data-hotkey="g"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="attributes">
                <attribute name="invisible" add="move_type in ('out_invoice', 'out_refund', 'out_receipt')" separator=" or "/>
            </xpath>
            <xpath expr="//button[@id='account_invoice_payment_secondary_btn']" position="after">
                <button name="action_register_payment" id="account_invoice_collect_secondary_btn"
                        type="object"
                        invisible="(
                            state != 'posted'
                            or payment_state not in ('not_paid', 'partial', 'in_payment')
                            or move_type not in ('out_invoice', 'out_refund', 'out_receipt')
                            or not invoice_has_outstanding
                        )"
                        context="{'dont_redirect_to_payments': True, 'display_account_trust': True}"
                        string="Collect" data-hotkey="g"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- Customer invoice / credit note lists have their own primary views -->
    <record id="view_out_invoice_tree" model="ir.ui.view">
        <field name="name">account.out.invoice.list.account_translation_improvements</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_force_register_payment']" position="attributes">
                <attribute name="string">Collect</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_out_credit_note_tree" model="ir.ui.view">
        <field name="name">account.out.credit.note.list.account_translation_improvements</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_force_register_payment']" position="attributes">
                <attribute name="string">Collect</attribute>
            </xpath>
        </field>
    </record>

</odoo>
