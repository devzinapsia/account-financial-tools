<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.vendor.bill.authorization.pro</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_payment_pro.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='pay_now_journal_id'][@groups='account_payment_pro.group_pay_now_vendor_invoices']" position="attributes">
                <attribute name="domain">[('company_id', '=', company_id), ('type', 'in', ['bank', 'cash', 'credit']), ('outbound_payment_method_line_ids.payment_method_id.code', '=', 'manual'), ('id', 'in', pay_now_available_journal_ids)]</attribute>
                <attribute name="readonly" separator=" or " add="not can_set_pay_now_journal"/>
            </xpath>
            <xpath expr="//group[@id='header_left_group']" position="inside">
                <field name="pay_now_available_journal_ids" invisible="1"/>
                <field name="can_set_pay_now_journal" invisible="1"/>
            </xpath>
        </field>
    </record>

</odoo>
