<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//RecipientsInput/.." position="after">
            <t t-if="transactionCc.available">
                <div class="d-flex py-1 ps-3 align-items-center o-mail-TransactionCc">
                    <span class="flex-shrink-0 text-end fw-bold px-2" style="width:46px">Cc: </span>
                    <div class="flex-grow-1 mx-1">
                        <TransactionCopiesInput
                            value="transactionCc.cc"
                            placeholder.translate="No visible copy"
                            title.translate="Emails separated by commas, or @user"
                            onInput="(value) => this.transactionCc.cc = value"
                            onCommit="(value) => this.onTransactionCcCommit('cc', value)"/>
                    </div>
                </div>
                <div class="d-flex py-1 ps-3 align-items-center o-mail-TransactionBcc">
                    <span class="flex-shrink-0 text-end fw-bold px-2" style="width:46px">Bcc: </span>
                    <div class="flex-grow-1 mx-1">
                        <TransactionCopiesInput
                            value="transactionCc.bcc"
                            placeholder.translate="No hidden copy"
                            title.translate="Emails separated by commas, or @user"
                            onInput="(value) => this.transactionCc.bcc = value"
                            onCommit="(value) => this.onTransactionCcCommit('bcc', value)"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
