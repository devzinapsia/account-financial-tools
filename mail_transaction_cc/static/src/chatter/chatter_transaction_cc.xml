<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//RecipientsInput/.." position="after">
            <t t-if="transactionCc.available">
                <div class="d-flex py-1 ps-3 align-items-center o-mail-TransactionCc">
                    <span class="flex-shrink-0 text-end fw-bold px-2" style="width:46px">Cc: </span>
                    <input type="text" class="form-control form-control-sm border-0 border-bottom rounded-0 mx-1"
                           t-model="transactionCc.cc" t-on-change="onTransactionCcChange"
                           placeholder="No visible copy" title="Emails separated by commas, or @user"/>
                </div>
                <div class="d-flex py-1 ps-3 align-items-center o-mail-TransactionBcc">
                    <span class="flex-shrink-0 text-end fw-bold px-2" style="width:46px">Bcc: </span>
                    <input type="text" class="form-control form-control-sm border-0 border-bottom rounded-0 mx-1"
                           t-model="transactionCc.bcc" t-on-change="onTransactionCcChange"
                           placeholder="No hidden copy" title="Emails separated by commas, or @user"/>
                </div>
            </t>
        </xpath>
    </t>
</templates>
