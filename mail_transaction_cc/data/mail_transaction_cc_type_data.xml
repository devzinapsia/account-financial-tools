<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transaction types are module-defined (not editable by users), so they
         stay updatable: fixes to their filters ship with module upgrades. -->
    <record id="type_customer_invoice" model="mail.transaction.cc.type">
        <field name="name">Customer invoice</field>
        <field name="code">customer_invoice</field>
        <field name="sequence">10</field>
        <field name="model_name">account.move</field>
        <field name="base_domain">[('move_type', 'in', ('out_invoice', 'out_refund'))]</field>
        <field name="responsible_field">invoice_user_id</field>
    </record>

    <record id="type_receipt" model="mail.transaction.cc.type">
        <field name="name">Receipt</field>
        <field name="code">receipt</field>
        <field name="sequence">20</field>
        <field name="model_name">account.payment</field>
        <field name="base_domain">[('partner_type', '=', 'customer')]</field>
        <field name="responsible_field">create_uid</field>
    </record>

    <record id="type_payment_order" model="mail.transaction.cc.type">
        <field name="name">Payment order</field>
        <field name="code">payment_order</field>
        <field name="sequence">30</field>
        <field name="model_name">account.payment</field>
        <field name="base_domain">[('partner_type', '=', 'supplier')]</field>
        <field name="responsible_field">create_uid</field>
    </record>

    <!-- Sales and Purchase types are declared even when those applications
         are not installed: they become available as soon as their model
         exists in the registry. -->
    <record id="type_sale" model="mail.transaction.cc.type">
        <field name="name">Quotation / sales order</field>
        <field name="code">sale</field>
        <field name="sequence">40</field>
        <field name="model_name">sale.order</field>
        <field name="base_domain">[]</field>
        <field name="responsible_field">user_id</field>
    </record>

    <record id="type_purchase" model="mail.transaction.cc.type">
        <field name="name">Request for quotation / purchase order</field>
        <field name="code">purchase</field>
        <field name="sequence">50</field>
        <field name="model_name">purchase.order</field>
        <field name="base_domain">[]</field>
        <field name="responsible_field">user_id</field>
    </record>

    <!-- Direct communication with contacts: messages sent from the chatter of
         a customer or vendor contact (or of one of its contact persons). -->
    <record id="type_partner_customer" model="mail.transaction.cc.type">
        <field name="name">Customer communication</field>
        <field name="code">partner_customer</field>
        <field name="sequence">60</field>
        <field name="model_name">res.partner</field>
        <field name="base_domain">[('commercial_partner_id.customer_rank', '>', 0)]</field>
        <field name="responsible_field">user_id</field>
        <field name="has_document" eval="False"/>
    </record>

    <!-- buyer_id exists only when Purchase is installed; without it, the
         responsible is simply not resolved. -->
    <record id="type_partner_vendor" model="mail.transaction.cc.type">
        <field name="name">Vendor communication</field>
        <field name="code">partner_vendor</field>
        <field name="sequence">70</field>
        <field name="model_name">res.partner</field>
        <field name="base_domain">[('commercial_partner_id.supplier_rank', '>', 0)]</field>
        <field name="responsible_field">buyer_id</field>
        <field name="has_document" eval="False"/>
    </record>
</odoo>
