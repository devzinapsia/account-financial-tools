<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Initial configurable values for the agreed payment method table.
         These are business terms in Spanish and are intentionally not
         translated (source text is already in Spanish). -->
    <record id="agreed_payment_method_transferencia" model="account.move.agreed.payment.method">
        <field name="name">Transferencia</field>
        <field name="sequence">10</field>
    </record>

    <record id="agreed_payment_method_mercado_pago" model="account.move.agreed.payment.method">
        <field name="name">Mercado Pago</field>
        <field name="sequence">20</field>
    </record>

    <record id="agreed_payment_method_cheque" model="account.move.agreed.payment.method">
        <field name="name">Cheque</field>
        <field name="sequence">30</field>
    </record>

    <record id="agreed_payment_method_efectivo" model="account.move.agreed.payment.method">
        <field name="name">Efectivo</field>
        <field name="sequence">40</field>
    </record>

    <record id="agreed_payment_method_tarjeta_precargada" model="account.move.agreed.payment.method">
        <field name="name">Tarjeta precargada</field>
        <field name="sequence">50</field>
    </record>

    <record id="agreed_payment_method_tarjeta_credito" model="account.move.agreed.payment.method">
        <field name="name">Tarjeta de crédito</field>
        <field name="sequence">60</field>
    </record>

    <record id="agreed_payment_method_otro" model="account.move.agreed.payment.method">
        <field name="name">Otro</field>
        <field name="sequence">70</field>
    </record>

</odoo>
