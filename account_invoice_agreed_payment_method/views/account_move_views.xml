<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the field to the header of the shared account.move form.
         Visible on vendor bills and vendor credit notes only, and
         editable only while the document is in draft state. -->
    <record id="view_move_form_agreed_payment_method" model="ir.ui.view">
        <field name="name">account.move.form.agreed.payment.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="journal_div" position="after">
                <field name="agreed_payment_method_id"
                       invisible="move_type not in ('in_invoice', 'in_refund')"
                       readonly="state != 'draft'"/>
            </div>
        </field>
    </record>

    <!-- Add the field as an optional column to the vendor bills list view. -->
    <record id="view_in_invoice_bill_tree_agreed_payment_method" model="ir.ui.view">
        <field name="name">account.move.in.invoice.bill.list.agreed.payment.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="agreed_payment_method_id" string="Agreed payment method" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- Add the field to the vendor bills search view: a searchable field
         and a "Group By" filter. Neither is active by default. -->
    <record id="view_account_bill_filter_agreed_payment_method" model="ir.ui.view">
        <field name="name">account.move.bill.filter.agreed.payment.method</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_bill_filter"/>
        <field name="arch" type="xml">
            <field name="next_payment_date" position="after">
                <field name="agreed_payment_method_id"
                       string="Agreed payment method"
                       filter_domain="[('agreed_payment_method_id.name', 'ilike', self)]"/>
            </field>
            <filter name="invoicedate" position="after">
                <filter string="Agreed payment method" name="group_by_agreed_payment_method"
                        context="{'group_by': 'agreed_payment_method_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
