<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="inflation_adjustment_form" model="ir.ui.view">
        <field name="name">inflation.adjustment.form.improvements</field>
        <field name="model">inflation.adjustment</field>
        <field name="inherit_id" ref="l10n_ar_account_reports.inflation_adjustment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="before">
                <div class="alert alert-warning" role="alert" invisible="not adjustment_warning">
                    <field name="adjustment_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="report_detail" widget="radio"/>
            </xpath>
            <xpath expr="//footer/button[@name='confirm']" position="after">
                <button string="Simulate PDF" name="action_simulate_pdf" type="object" class="btn-secondary"
                        help="Download the adjustment detail without creating the entry."/>
                <button string="Simulate Excel" name="action_simulate_xlsx" type="object" class="btn-secondary"
                        help="Download the adjustment detail, by month and by entry, without creating the entry."/>
            </xpath>
            <!-- Upstream's single closing/opening entry fields, next to the
                 first question, are replaced by the lists below -->
            <xpath expr="//field[@name='closure_move_id']/.." position="replace"/>
            <xpath expr="//field[@name='open_move_id']/.." position="replace"/>
            <xpath expr="//field[@name='open_cloure_entry']/.." position="after">
                <label for="first_odoo_fiscal_year" invisible="open_cloure_entry != 'yes'"/>
                <div class="o_row" invisible="open_cloure_entry != 'yes'">
                    <field name="first_odoo_fiscal_year" widget="radio" nolabel="1"
                           required="open_cloure_entry == 'yes'"/>
                </div>
                <field name="closing_move_ids" widget="many2many_tags"
                       invisible="open_cloure_entry != 'yes' or first_odoo_fiscal_year == 'yes'"
                       required="open_cloure_entry == 'yes' and first_odoo_fiscal_year != 'yes'"
                       options="{'no_create': True}"/>
                <field name="opening_move_ids" widget="many2many_tags"
                       invisible="open_cloure_entry != 'yes'"
                       required="open_cloure_entry == 'yes'"
                       options="{'no_create': True}"/>
                <div class="text-muted" colspan="2"
                     invisible="open_cloure_entry != 'yes' or first_odoo_fiscal_year != 'yes'">
                    Adjusted as initial balances, from the month before the start date.
                </div>
            </xpath>
        </field>
    </record>

</odoo>
