<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_arca_bill_comparison_wizard_form" model="ir.ui.view">
        <field name="name">arca.bill.comparison.wizard.form</field>
        <field name="model">arca.bill.comparison.wizard</field>
        <field name="arch" type="xml">
            <form string="My Vouchers">
                <group>
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" required="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_process" type="object" string="Process" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_arca_bill_comparison_wizard" model="ir.actions.act_window">
        <field name="name">My Vouchers</field>
        <field name="res_model">arca.bill.comparison.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
