<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_arca_bill_comparison_batch_list" model="ir.ui.view">
        <field name="name">arca.bill.comparison.batch.list</field>
        <field name="model">arca.bill.comparison.batch</field>
        <field name="arch" type="xml">
            <list string="My Vouchers - Runs">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="user_id"/>
                <field name="line_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_arca_bill_comparison_batch_form" model="ir.ui.view">
        <field name="name">arca.bill.comparison.batch.form</field>
        <field name="model">arca.bill.comparison.batch</field>
        <field name="arch" type="xml">
            <form string="My Vouchers - Run">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo" string="Results"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_arca_bill_comparison_batch" model="ir.actions.act_window">
        <field name="name">My Vouchers - Runs</field>
        <field name="res_model">arca.bill.comparison.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
