<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="account_move_classification.ClassificationBadgeField">
        <t t-if="props.readonly">
            <!-- Readonly: colored badge chip, empty when no value -->
            <span t-if="hasValue"
                  class="o_tag o_badge badge rounded-pill"
                  t-attf-class="o_tag_color_{{ colorIndex }}"
                  t-esc="displayName"/>
        </t>
        <t t-else="">
            <!-- Edit: colored chip (with ×) when a value is set; autocomplete input when empty -->
            <div class="o_field_many2many_tags d-flex flex-wrap align-items-center gap-1">
                <TagsList tags="tags"/>
                <Many2XAutocomplete
                    t-if="!hasValue"
                    resModel="relation"
                    activeActions="activeActions"
                    getDomain="getDomain"
                    fieldString="props.string or ''"
                    update="update"
                    context="props.context or {}"
                    placeholder="props.placeholder"
                    searchThreshold="props.searchThreshold or 0"
                    nameCreateField="props.nameCreateField or 'name'"
                    specification="specification"
                    autoSelect="true"
                />
            </div>
        </t>
    </t>

</templates>
